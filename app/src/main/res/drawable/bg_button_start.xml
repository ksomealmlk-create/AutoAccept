<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/accent_teal_dark"/><corners android:radius="18dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><gradient android:angle="0" android:startColor="@color/accent_purple" android:endColor="@color/accent_teal"/><corners android:radius="18dp"/></shape>
    </item>
</selector>
