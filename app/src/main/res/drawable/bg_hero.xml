<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_teal_dark"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/accent_teal" android:centerColor="@color/accent_blue" android:endColor="@color/accent_purple"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</selector>
