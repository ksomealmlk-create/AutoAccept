<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="الإعدادات"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="تحكم كامل"
                android:textColor="@color/accent_teal"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="شغّل أو أطفئ كل وظيفة بالطريقة التي تناسبك"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="الأتمتة"
            android:textColor="@color/accent_teal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_teal"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="قبول الرحلات ضمن المسافة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="يضغط قبول تلقائيًا للرحلة المناسبة"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/infoAccept"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Switch
                    android:id="@+id/swAutoAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_teal" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_purple"
                    android:gravity="center"
                    android:text="×"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="تجاهل الرحلات خارج المسافة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="يتعامل مع لا، شكرًا تلقائيًا"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/infoReject"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Switch
                    android:id="@+id/swAutoReject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_blue"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إغلاق رسالة موافق"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="يعالج رسالة أخذ الحجز من سائق آخر"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/infoConfirm"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Switch
                    android:id="@+id/swAutoConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_teal"
                    android:gravity="center"
                    android:text="▥"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="تسجيل الإحصائيات"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="حفظ عمليات القبول والتجاهل"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/infoStats"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Switch
                    android:id="@+id/swStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_blue"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="لقطة شاشة لكل رحلة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="تظهر بالإحصائيات > لقطات الرحلات (تحتاج الإحصائيات مشغّلة)"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/swShots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_blue"
                    android:gravity="center"
                    android:text="♪"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="تنبيه صوتي عند القبول"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="ثلاث نغمات (طن طن طن) عند قبول الطلب"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <Switch
                    android:id="@+id/swSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="المسافة"
            android:textColor="@color/accent_blue"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/distHeader"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_purple"
                    android:gravity="center"
                    android:text="↔"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="أقصى مسافة للطلب"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvDistanceSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="حتى 3 كم"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/infoDistance"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/distArrow"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="▾"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/distPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <RadioGroup
                    android:id="@+id/rgDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">
                    <RadioButton android:id="@+id/rb1km" android:layout_width="match_parent" android:layout_height="44dp" android:text="حتى 1 كم" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <RadioButton android:id="@+id/rb2km" android:layout_width="match_parent" android:layout_height="44dp" android:text="حتى 2 كم" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <RadioButton android:id="@+id/rb25km" android:layout_width="match_parent" android:layout_height="44dp" android:text="حتى 2.5 كم" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <RadioButton android:id="@+id/rb275km" android:layout_width="match_parent" android:layout_height="44dp" android:text="حتى 2.75 كم" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <RadioButton android:id="@+id/rb3km" android:layout_width="match_parent" android:layout_height="44dp" android:text="حتى 3 كم" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <RadioButton android:id="@+id/rbAny" android:layout_width="match_parent" android:layout_height="44dp" android:text="بدون حد للمسافة" android:textColor="@color/accent_teal" android:textSize="13sp" android:textStyle="bold" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="الأحياء"
            android:textColor="@color/accent_teal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/neighHeader"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="5dp">
                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_blue"
                    android:gravity="center"
                    android:text="⌂"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="فلتر أحياء النجف"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvNeighSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="حي مكان الزبون فقط، إضافةً للمسافة"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/infoNeigh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_info_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="i"
                    android:textColor="@color/accent_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <Switch
                    android:id="@+id/swNeighborhood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/neighArrow"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="▾"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/neighPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <Button
                        android:id="@+id/btnSelectAll"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_card"
                        android:stateListAnimator="@null"
                        android:text="تحديد الكل"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_teal"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnClearAll"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_card"
                        android:stateListAnimator="@null"
                        android:text="إلغاء الكل"
                        android:textAllCaps="false"
                        android:textColor="@color/danger"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/neighContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="مظهر البرنامج"
                android:textColor="@color/accent_purple"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/infoTheme"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_info_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="i"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rgTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbThemeSystem"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_theme_choice"
                android:buttonTint="@color/accent_blue"
                android:gravity="center"
                android:text="النظام\nتلقائي"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbThemeLight"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_theme_choice"
                android:buttonTint="@color/warning"
                android:gravity="center"
                android:text="☀\nنهاري"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbThemeDark"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_theme_choice"
                android:buttonTint="@color/accent_purple"
                android:gravity="center"
                android:text="☾\nليلي"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_hero"
            android:stateListAnimator="@null"
            android:text="حفظ الإعدادات"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
